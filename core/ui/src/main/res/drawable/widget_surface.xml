<?xml version="1.0" encoding="utf-8"?>
<!-- A quieter premium card: the same translucent glass as the classic widget,
     with a slightly larger radius so the Studio styles read as a family. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6FAFAF8" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33D9D9D6" />
</shape>
