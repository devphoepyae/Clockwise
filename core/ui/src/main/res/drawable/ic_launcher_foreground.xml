<?xml version="1.0" encoding="utf-8"?>
<!--
  Clockwise app icon, foreground layer.

  A luxury watch face on the navy field: a champagne-gold bezel, an ivory dial
  with four cardinal markers, and the classic 10:10 pose. The second hand sits
  at 35 seconds, between the 6 and the 8, so the three hands never overlap.

  Everything stays inside the 27 dp dial (x/y 27..81), well within the central
  66 dp safe zone (21..87), so no launcher mask crops the watch.

  Palette
    bezel   #C9A35B  champagne gold
    dial    #0E2440  enamel navy, one step lighter than the field
    ivory   #F4EAD5  warm ivory for the hour hand and markers
    gold    #D8B36A  minute hand, second hand and centre pin
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Enamel dial with a polished gold bezel. -->
    <path
        android:fillColor="#FF0E2440"
        android:pathData="M54,27 A27,27 0 1,0 54,81 A27,27 0 1,0 54,27 Z"
        android:strokeColor="#FFC9A35B"
        android:strokeWidth="2.4" />

    <!-- Inner hairline, the chapter ring. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,31 A23,23 0 1,0 54,77 A23,23 0 1,0 54,31 Z"
        android:strokeColor="#55F4EAD5"
        android:strokeWidth="1" />

    <!-- Cardinal markers: 12 and 6 in gold, 3 and 9 in ivory. -->
    <path
        android:fillColor="#FFD8B36A"
        android:pathData="M52.9,32.4 L55.1,32.4 L55.1,37.2 L52.9,37.2 Z" />
    <path
        android:fillColor="#FFD8B36A"
        android:pathData="M52.9,70.8 L55.1,70.8 L55.1,75.6 L52.9,75.6 Z" />
    <path
        android:fillColor="#FFF4EAD5"
        android:pathData="M70.8,52.9 L75.6,52.9 L75.6,55.1 L70.8,55.1 Z" />
    <path
        android:fillColor="#FFF4EAD5"
        android:pathData="M32.4,52.9 L37.2,52.9 L37.2,55.1 L32.4,55.1 Z" />

    <!-- Hour hand at 10 o'clock, warm ivory. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L43.2,47.8"
        android:strokeColor="#FFF4EAD5"
        android:strokeLineCap="round"
        android:strokeWidth="4.6" />

    <!-- Minute hand at 10 minutes past, champagne gold. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L70.5,44.5"
        android:strokeColor="#FFD8B36A"
        android:strokeLineCap="round"
        android:strokeWidth="3.4" />

    <!-- Second hand at 35 seconds: through the centre, with a short tail. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M56.4,43.1 L43.2,73.2"
        android:strokeColor="#FFD8B36A"
        android:strokeLineCap="round"
        android:strokeWidth="1.4" />

    <!-- Centre pin: gold ring around a navy jewel. -->
    <path
        android:fillColor="#FFD8B36A"
        android:pathData="M54,51 A3,3 0 1,0 54,57 A3,3 0 1,0 54,51 Z" />
    <path
        android:fillColor="#FF0E2440"
        android:pathData="M54,52.6 A1.4,1.4 0 1,0 54,55.4 A1.4,1.4 0 1,0 54,52.6 Z" />

    <!-- Nameplate: a quiet gold underline at 6 o'clock. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46.5,72.2 L61.5,72.2"
        android:strokeColor="#88D8B36A"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
</vector>
