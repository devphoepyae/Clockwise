    <!-- About -->
    <string name="about_eyebrow">ABOUT</string>
    <string name="about_title">Clockwise</string>
    <string name="about_version_title">Version</string>
    <string name="about_version_body">1.0.10</string>
    <string name="about_privacy_title">Private by design</string>
    <string name="about_privacy_body">Clockwise has no internet permission. There is no server, no account, no sync and no analytics. Your cities, labels and preferences never leave this device.</string>
    <string name="about_footnote">Made for anyone who keeps an eye on more than one time zone.</string>

    <!-- Legal & Support accordion -->
    <string name="legal_privacy_title">Zero-Internet &amp; Privacy Policy</string>
    <string name="legal_privacy_body">Clockwise runs offline-first: it asks for no internet permission, keeps no account, runs no server and collects nothing. Every city, alarm, timer and preference is stored on this device, and the alarm and vault information stays in local storage until you delete it. Nothing the app holds ever leaves the phone.</string>
    <string name="legal_guide_title">App Guide &amp; Chronos Tips</string>
    <string name="legal_guide_body">Global clocks show the local time of each saved city and how far it sits from your own; the meeting planner finds an hour that works across time zones; alarms repeat on the days you choose and one-shots switch themselves off after ringing; the timer keeps counting while the app is closed; swipe up to snooze and slide to stop. Chronos widgets bring those clocks to the home screen, one style per widget, pinned from the gallery.</string>
    <string name="legal_terms_title">Terms of Service</string>
    <string name="legal_terms_body">Clockwise is a personal offline-first clock and alarm app. By using it you accept that it stores your cities, alarms, timers and preferences locally on your device, that it keeps no account or sync service, and that the alarm times you configure are yours to keep. The service is provided as-is for personal use; you may not redistribute it or use it for automated access. The Android platform and the open-source components it is built from keep their own licenses.</string>
    <string name="legal_licenses_title">Open Source Licenses</string>
    <string name="legal_licenses_body">Clockwise is built on open-source foundations: Kotlin, Jetpack Compose, Material 3, Room and the Android AlarmManager and media playback APIs, and each keeps its own license. The Clockwise application code is distributed with these terms; no bundled component here phones home, and none of them needs a network to read their terms.</string>
    <string name="legal_about_title">About &amp; Version Info &amp; Feedback</string>
    <string name="legal_show_intro">Show intro</string>
    <string name="legal_send_feedback">Send feedback</string>
    <string name="legal_developer_name">PJ95 Studio</string>

