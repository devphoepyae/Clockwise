    <!-- Privacy policy -->
    <string name="privacy_eyebrow">PRIVATE BY DESIGN</string>
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_offline_title">Nothing leaves your phone</string>
    <string name="privacy_offline_body">Clockwise does not request the internet permission. There is no server, no account and no sync. Every clock, alarm, timer and preference is computed and stored on this device.</string>
    <string name="privacy_stored_title">What is stored</string>
    <string name="privacy_stored_body">Your saved cities, city labels, alarms, the running timer, display preferences and whether the intro has been shown. These live in the app\'s private storage and are removed when you uninstall the app or clear its data.</string>
    <string name="privacy_ads_title">No ads, trackers or analytics</string>
    <string name="privacy_ads_body">No advertising SDK, analytics library, crash reporter or billing library is included. The app cannot send a crash report, an install event or a usage statistic, because it has no way to reach a network.</string>
    <string name="privacy_feedback_title">Feedback is yours to send</string>
    <string name="privacy_feedback_body">Send feedback opens your own mail app with a short diagnostic note — app version, Android version, device model, locale, time zone and alarm permission states. Nothing is sent until you press send in that app, and you can edit or delete every line first.</string>
    <string name="privacy_control_title">Your control</string>
    <string name="privacy_control_body">You can remove a city, an alarm or the timer at any time, or clear all app data from Android settings. There is no profile to delete and no request to make.</string>
    <string name="privacy_footnote">Last updated October 2026 · applies to Clockwise 1.0 and later.</string>

    <!-- Help -->
    <string name="help_eyebrow">HOW IT WORKS</string>
    <string name="help_title">Help</string>
    <string name="help_alarms_title">Alarms and timers</string>
    <string name="help_alarms_body">An alarm repeats on the days you choose; a one-shot alarm switches itself off after it rings. Tap the hourglass in the Alarms header to open the timer, and the close button or Back to return. The timer keeps counting while the app is closed and survives a reboot. A ringing alarm opens full screen over the lock screen and sounds on the alarm stream, so it is heard even in Doze or silent mode.</string>
    <string name="help_exact_title">Exact alarms</string>
    <string name="help_exact_body">Android may delay background work, so the app asks for exact alarms. On Android 13 and later this is granted automatically to alarm-clock apps. On Android 12 and 12L, open Settings → Alarms → Exact alarms and allow it. Without it, alarms still ring, but they may be a few minutes late.</string>
    <string name="help_notifications_title">Notifications and the lock screen</string>
    <string name="help_notifications_body">The ring is a notification with a full-screen intent, which is what lets it appear over the lock screen. Allow notifications for the app, and do not silence its alarm channel. If you deny notifications, the alarm screen can still open when you tap the app, but the phone will not ring on its own.</string>
    <string name="help_dnd_title">Do Not Disturb</string>
    <string name="help_dnd_body">The alarm and timer channels are marked to bypass Do Not Disturb. To make that effective, grant notification policy access in Settings → Alarms → Do Not Disturb. The app never changes your DND schedule and never turns DND on or off.</string>
    <string name="help_battery_title">Battery optimisation</string>
    <string name="help_battery_body">Some phones delay background alarms aggressively. If an alarm has ever arrived late, exempt Clockwise from battery optimisation in Settings → Alarms → Battery optimisation. The app does not ask for the exemption automatically, because that prompt is easy to distrust.</string>
    <string name="help_screensaver_title">Screen saver</string>
    <string name="help_screensaver_body">Settings → Screen saver shows a full-screen desk clock. The type drifts slowly to avoid burn-in, and the display stays awake until you tap or press Back. It is not an Android Daydream and stops as soon as you leave it.</string>
    <string name="help_footnote">Everything here works without a connection.</string>

