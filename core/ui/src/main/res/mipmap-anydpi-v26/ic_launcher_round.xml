<?xml version="1.0" encoding="utf-8"?>
<!--
  Round-mask launcher icon, PJ95 "Concept 3".

  The same three layers as ic_launcher.xml: the platform applies the round mask,
  so duplicating the artwork here is what keeps a circular launcher from
  letterboxing the square variant.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
