<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget's provider info (spec section 5.11).

  minWidth/minHeight are the default footprint: four cells by four, which is
  exactly what the tallest responsive layout needs, so a freshly added widget
  shows every default city without being resized first. minResizeWidth/Height
  are deliberately smaller than that: they let the user shrink the card down to
  the 2x2 layout without changing the footprint it starts at. targetCell* is the
  same default expressed the API 31+ way, and is ignored below that.

  previewImage is the fallback for devices below Android 15, and for Android 15+
  until the generated preview has been published. On Android 15+, Glance's
  setWidgetPreviews replaces it with a live render of the card.

  updatePeriodMillis is the platform's own, permission-free backstop at 30
  minutes (its minimum). The minute-accurate refresh is the AlarmManager ticker
  in WidgetTicker, and this is what puts that ticker back if it is ever lost.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="250dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
