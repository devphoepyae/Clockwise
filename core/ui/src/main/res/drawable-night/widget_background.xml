<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card in the device's dark setting. Same reasoning as
  `drawable/widget_background.xml`; the fill is the dark card token at 94%
  opacity with a faint light outline so the card separates from a dark
  wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F01A1A1A" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#40E1E1DE" />
</shape>
